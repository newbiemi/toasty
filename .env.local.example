# Toasty runs fully offline — no cloud AI or Supabase required at runtime.
# These env vars are optional overrides for the Ollama integration.

# Override the Ollama server URL (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Override the default model (default: llama3.2:3b)
# The model can also be changed at runtime via Settings → MODEL in the app UI.
# OLLAMA_MODEL=llama3.2:3b

# ─── One-time data import ─────────────────────────────────────────────────────
# To import existing tasks from a Supabase project into toasty.db, see:
#   scripts/migrate.env.example  →  copy to scripts/migrate.env and run: npm run migrate
