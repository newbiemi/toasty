# ─── AI Provider ─────────────────────────────
# Switch between "gemini" (free) and "anthropic" (paid)
AI_PROVIDER=gemini

# Gemini (free tier) — get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (paid) — get key at https://console.anthropic.com
# Uncomment when ready to switch:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Supabase (free tier) ───────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
