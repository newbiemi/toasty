{
  "name": "toasty",
  "version": "0.5.0",
  "description": "Pixel-cat task companion — Groq cloud AI, offline rule fallback, Electron + SQLite",
  "private": true,
  "main": "app/background.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "rebuild": "electron-builder install-app-deps",
    "icons": "node scripts/generate-icons.js",
    "migrate": "electron scripts/migrate-from-supabase.js",
    "bench:build": "tsc -p tsconfig.bench.json",
    "bench": "npm run bench:build && electron bench/run.js",
    "bench:live": "npm run bench:build && electron bench/run.js --live",
    "bench:adjust": "npm run bench:build && electron bench/adjust-smoke.js",
    "bench:chat": "npm run bench:build && electron bench/chat-check.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron-serve": "^1.3.0",
    "electron-updater": "^6.8.9",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "nextron": "^8.13.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.fahmi.toasty",
    "productName": "Toasty",
    "files": [
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "newbiemi",
      "repo": "toasty"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
