# Supabase credentials for the one-time data import.
# Copy this file → scripts/migrate.env and fill in your values.
# scripts/migrate.env is gitignored — never commit it.

# From: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here

# The name of the table to import from (default: tasks)
# SUPABASE_TABLE=tasks
