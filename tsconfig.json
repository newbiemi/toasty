{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "app",
    "sourceMap": true
  },
  "include": ["main/**/*"],
  "exclude": ["node_modules", "renderer", "app"]
}
